<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  package="id.oddbit.flutter.facebook_app_events">

  <uses-permission android:name="android.permission.INTERNET"/>

  <application>
    <!--
      Runtime JSON is authoritative for Facebook credentials. Removing Meta's
      manifest provider prevents credentials left behind by older versions of
      the host app from starting App Events before Dart has loaded the current
      remote (or cached) configuration.
    -->
    <provider
      android:name="com.facebook.internal.FacebookInitProvider"
      tools:node="remove" />
  </application>
</manifest>
